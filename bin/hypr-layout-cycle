#!/usr/bin/env bash
# hypr-layout-cycle — cycle the tiled layout of the active workspace:
# dwindle -> master -> scrolling -> dwindle -> ...
#
# The chosen layout is persisted per workspace through Omarchy's built-in
# workspace-layouts state, so it survives restarts.
#
# Usage: hypr-layout-cycle   (bind it to Super+L)

ACTIVE_WORKSPACE=$(hyprctl activeworkspace -j | jq -r '.id')
[[ $ACTIVE_WORKSPACE =~ ^-?[0-9]+$ ]] || exit 1

CURRENT_LAYOUT=$(hyprctl activeworkspace -j | jq -r '.tiledLayout')

case "$CURRENT_LAYOUT" in
  dwindle)  NEW_LAYOUT=master ;;
  master)   NEW_LAYOUT=scrolling ;;
  *)        NEW_LAYOUT=dwindle ;;
esac

mkdir -p "$HOME/.local/state/omarchy/workspace-layouts"
LAYOUT_FILE="$HOME/.local/state/omarchy/workspace-layouts/$ACTIVE_WORKSPACE.lua"
printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$ACTIVE_WORKSPACE" "$NEW_LAYOUT" > "$LAYOUT_FILE"

hyprctl eval "hl.workspace_rule({ workspace = \"$ACTIVE_WORKSPACE\", layout = \"$NEW_LAYOUT\" })" >/dev/null 2>&1 || \
  hyprctl keyword workspace "$ACTIVE_WORKSPACE, layout:$NEW_LAYOUT"

omarchy-notification-send -g 󰨝 "Workspace layout set to $NEW_LAYOUT"
